// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "proxy": "",
  "soft_wrap": "editor_width",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "format_on_save": "on",
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
  },
  "buffer_font_family": "AdwaitaMono Nerd Font",
  "restore_on_startup": "last_workspace",
  "session": {
    "trust_all_worktrees": true,
  },
  "inlay_hints": {
    "show_background": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
  },
  "outline_panel": {
    "dock": "right",
  },
  "wrap_guides": [80, 100],
  "base_keymap": "Zed",
  "agent_servers": {
    "opencode-v2": {
      "default_config_options": {
        "mode": "plan",
        "effort": "high",
        "model": "opencode/deepseek-v4.1-flash-free"
      },
      "type": "registry"
    },
    "github-copilot-cli": {
      "default_config_options": {
        "allow_all": "off",
        "model": "gpt-6-luna",
      },
      "favorite_config_option_values": {
        "model": [
          "claude-haiku-5.5",
          "gpt-6-luna",
          "mai-code-1.1-flash",
          "gemini-3.8-flash",
        ],
      },
      "type": "registry",
    },
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "registry.npmjs.org"
      ]
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "claude-haiku-5.5",
      "enable_thinking": true,
    },
    "threads_sidebar": {
      "position": "right",
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-5.5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "mai-code-1.1-flash",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-5.5",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
  },
  "project_panel": {
    "folder_indicator": "chevron",
    "entry_spacing": "comfortable",
    "dock": "left",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Adwaita Light",
    "dark": "Adwaita Dark",
  },
}
